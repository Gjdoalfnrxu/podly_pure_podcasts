# Thin overlay on the pinned upstream 2.5.0 image: adds OPML import.
# Only the changed backend modules and the rebuilt frontend are replaced;
# Python deps, venv and system packages come from the upstream image as-is.
#   docker build -f Dockerfile.cain -t podly-cain:opml .
ARG PODLY_BASE=ghcr.io/podly-pure-podcasts/podly-pure-podcasts:2.5.0-latest-amd64@sha256:132c49601444412302ca5de50b2c1e2d72898ea28fd3fce4ce0923cb01df1f13

# Same toolchain as upstream's Dockerfile frontend stage.
FROM node:18-alpine AS frontend-build
WORKDIR /app
COPY frontend/package*.json ./
RUN npm ci
COPY frontend/ ./
RUN npm run build && test -f dist/index.html

FROM ${PODLY_BASE}
# Must list every src/ file this branch changes:
#   git diff --name-only v2.5.0 -- src ':!src/tests'  (upstream tag, not cain/2.5.0)
COPY src/app/cloud_lane.py \
     src/app/config_store.py \
     src/app/feed_fetch.py \
     src/app/feeds.py \
     src/app/job_manager.py \
     src/app/jobs_manager.py \
     src/app/lane_store.py \
     src/app/lanes.py \
     src/app/models.py \
     src/app/opml.py \
     src/app/opml_import.py \
     /app/src/app/
COPY src/app/routes/__init__.py \
     src/app/routes/feed_links.py \
     src/app/routes/feed_routes.py \
     src/app/routes/feed_subscribe.py \
     src/app/routes/lane_routes.py \
     src/app/routes/opml_routes.py \
     src/app/routes/post_routes.py \
     /app/src/app/routes/
COPY src/app/writer/actions/__init__.py \
     src/app/writer/actions/cleanup.py \
     src/app/writer/actions/jobs.py \
     src/app/writer/actions/lanes.py \
     /app/src/app/writer/actions/
COPY src/app/writer/executor.py /app/src/app/writer/
COPY src/migrations/versions/c1a0de1a9e5f_cloud_fast_lane.py /app/src/migrations/versions/
COPY src/podcast_processor/ad_classifier.py \
     src/podcast_processor/boundary_refiner.py \
     src/podcast_processor/model_output.py \
     src/podcast_processor/processing_status_manager.py \
     src/podcast_processor/transcription_manager.py \
     src/podcast_processor/word_boundary_refiner.py \
     /app/src/podcast_processor/
COPY src/shared/config.py \
     src/shared/defaults.py \
     src/shared/llm_utils.py \
     /app/src/shared/
# Drop the old hashed bundles so only the rebuilt index.html + assets ship.
RUN rm -rf /app/src/app/static/assets
COPY --from=frontend-build /app/dist /app/src/app/static
